<UserControl x:Class="L_Joyce.Views.CommandeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:L_Joyce.Views" xmlns:viewmodels="clr-namespace:L_Joyce.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:CommandeViewModel}"
        mc:Ignorable="d"
        d:DesignHeight="450" d:DesignWidth="800">
       
    <Grid>
        <Grid Background="#FFBFCDDB" >

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="218*" />
                <ColumnDefinition Width="252*" />
                <ColumnDefinition Width="257*"  />
                <ColumnDefinition Width="73*"  />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition   Height="4*"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Border Grid.Column="0" Grid.RowSpan="3" Background="White" />
            <StackPanel Grid.Column="0">
                <ListBox ItemsSource="{Binding CmdList}"  Margin="10,5,10,0" MinHeight="30" SelectedItem="{Binding Commande,Mode=TwoWay}" IsSynchronizedWithCurrentItem="True" IsEnabled="{Binding IsEnabledList}" >
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <WrapPanel>
                                <TextBlock Text="{Binding Id_Commande}" Margin="10,0,0,0"/>
                                <TextBlock Text="{Binding Id_Client}" Margin= "10,0,0,0"/>
                                <TextBlock Text="{Binding Client.Nom}" Margin= "10,0,0,0"/>
                                <TextBlock Text="{Binding Date_Commande}"/>
                               
                            </WrapPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </StackPanel>
            <StackPanel Grid.Column="1">
                <WrapPanel  Height="50"   >
                    <Label Width="100" Content="Id : "/>
                    <TextBlock Text="{Binding Commande.Id_Commande}" IsEnabled="{Binding IsReadOnly}" Width="150"/>
                </WrapPanel>
                <WrapPanel Height="50"    >
                    <TextBlock Text="Date  Commande :"  FontWeight="Bold"    Width="100"/>
                    <DatePicker SelectedDate="{Binding Commande.Date_Commande, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled}"/>
                </WrapPanel>
                <WrapPanel  Height="50"  >
                    <TextBlock Text="Date Requise :"  FontWeight="Bold"/>
                    <DatePicker SelectedDate="{Binding Commande.Date_Req, Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled}" />
                </WrapPanel>
                <WrapPanel  Height="50"  >
                    <Label  Content="Total Commande:" FontWeight="Bold"/>
                    <TextBox Text="{Binding Commande.Total_Commande, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled}" Width="140"/>
                </WrapPanel>

            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,25,0,0" >
                <WrapPanel Height="50">
                    <Label Width="60" Content="Client:"/>
                    <TextBox 
        Text="{Binding Commande.Id_Client, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
        IsEnabled="{Binding IsEnabled}" 
        Width="50"/>
                    <ComboBox Name="CBOXclient"   
        ItemsSource="{Binding ClientsViewSource}" 
        DisplayMemberPath="Nom" 
        SelectedValue="{Binding Commande.Id_Client, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
        SelectedValuePath="Id_client"
        IsEnabled="{Binding IsEnabled}"
        HorizontalAlignment="Left" Height="23" Margin="10,3,3,3" VerticalAlignment="Center" Width="100"/>
                </WrapPanel>

                <WrapPanel Height="50">
                    <Label Width="60" Content="Vendeur:" />
                    <TextBox 
        Text="{Binding Commande.Id_Vendeur, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
        IsEnabled="{Binding IsEnabled}" 
        Width="50"/>
                    <ComboBox Name="CBOvendeur"   
        ItemsSource="{Binding VendeursViewSource}" 
        DisplayMemberPath="Nom" 
        SelectedValue="{Binding Commande.Id_Vendeur, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
        SelectedValuePath="Id_vendeur" 
        IsEnabled="{Binding IsEnabled}"
        HorizontalAlignment="Left" Height="23" Margin="10,3,3,3" VerticalAlignment="Center" Width="100"/>
                </WrapPanel>

                
            </StackPanel>
            <StackPanel Grid.Column="3" >
                <Button Command="{Binding AddPersonneCommand}" Content="Add" Margin="0,20,0,0" />
                <Button  Command="{Binding EditCommand}" Content="Edit" Margin="0,20,0,0"/>
                <Button Command="{Binding DeletePersonneCommand}" Content="Delete" Margin="0,20,0,0"/>
                <Button Content="SAVE" Command="{Binding SaveCommand}" IsEnabled="{Binding IsEnabled}" Margin="0,20,0,0" />
                <Button  Command="{Binding CancelCommand}" Content="CANCEL" IsEnabled="{Binding IsEnabled}" Margin="0,20,0,0"/>
            </StackPanel>
            <StackPanel
   Grid.Column="3"  Grid.Row="1" >
                <Button Name="AddEnfant"  Command="{Binding AddEnfant}" Margin="-15,25,0,0"  Content="AddEnfant" Style="{StaticResource NavButton}" Width="100" FontSize="14" />
                <Button x:Name="DeleteEnfant" Command="{Binding DeleteEnfant}"   CommandParameter="{Binding SelectedComProd}" Margin="-18,25,0,0"   Content="DeleteEnfant"  Style="{StaticResource NavButton}" Width="100" FontSize="14" />
            </StackPanel>
          

            <DataGrid x:Name="ComProdsGrid"
  Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
  ItemsSource="{Binding Commande.ComProds}"
  AutoGenerateColumns="False"
  Margin="5"
  IsReadOnly="{Binding IsReadOnly}"
  SelectedItem="{Binding SelectedComProd, Mode=TwoWay}">

                <DataGrid.RowBackground>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FFDAE3E4" Offset="0.49"/>
                        <GradientStop Color="#FFE6F0F1" Offset="0.5"/>
                    </LinearGradientBrush>
                </DataGrid.RowBackground>

                <DataGrid.Columns>
                    <!-- Id_ComProd -->
                    <DataGridTextColumn Header="Id ComProd"
                    Binding="{Binding Id_ComProd}" 
                    IsReadOnly="True"/>

                    <!-- Id_Commande-->
                    <DataGridTextColumn Header="Id Commande"
                    Binding="{Binding Id_Commande}" 
                    IsReadOnly="True"/>

                    <!-- Id_Produit -->
                    <DataGridTextColumn Header="Id Produit"
                    Binding="{Binding Id_Produit}" 
                    IsReadOnly="True"/>

                    <!-- Description -->
                    <DataGridTextColumn Header="Description"
                     Binding="{Binding Produit.Nom}" 
                     IsReadOnly="True"/>

                    <!-- Qte Com -->
                    <DataGridTextColumn Header="Qte Com"
                    Binding="{Binding Qte_Com }" 
                    IsReadOnly="True"/>

                    <!-- prix vente -->
                    <DataGridTextColumn Header="Prix Vente"
                     Binding="{Binding Prix_Vente}" 
                     IsReadOnly="True"/>

                    <!-- prix vente -->
                    <DataGridTextColumn Header="Total"
                     
                      IsReadOnly="True"/>
                
                </DataGrid.Columns>

            </DataGrid>
        </Grid>
        <Grid IsHitTestVisible="False" ShowGridLines="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />

                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="4*" />
                <RowDefinition Height="3*" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
        </Grid>
    </Grid>
</UserControl>
